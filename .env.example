# TV Guide Framework Configuration

# ==================================================
# REGION CONFIGURATION
# ==================================================

# Default region to use when no region is specified
NEXT_PUBLIC_DEFAULT_REGION=uk

# Comma-separated list of enabled regions
# Available: uk, us, (add more as you create plugins)
NEXT_PUBLIC_ENABLED_REGIONS=uk,us

# ==================================================
# FEATURE FLAGS
# ==================================================

# Enable/disable features (true/false)
NEXT_PUBLIC_FEATURE_LIVE_NOW=true
NEXT_PUBLIC_FEATURE_UPCOMING=true
NEXT_PUBLIC_FEATURE_STREAMING_APPS=true
NEXT_PUBLIC_FEATURE_SEARCH=true
NEXT_PUBLIC_FEATURE_FILTERS=true

# ==================================================
# CACHING
# ==================================================

# Enable caching for provider responses
NEXT_PUBLIC_CACHE_ENABLED=true

# Cache time-to-live in seconds (default: 300 = 5 minutes)
NEXT_PUBLIC_CACHE_TTL=300

# ==================================================
# PERFORMANCE
# ==================================================

# Maximum concurrent provider requests
MAX_CONCURRENT_REQUESTS=5

# Request timeout in milliseconds
REQUEST_TIMEOUT=10000

# ==================================================
# ANALYTICS & LOGGING
# ==================================================

# Enable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ==================================================
# PROVIDER API KEYS (Optional)
# ==================================================

# Optional override: XMLTV feed URL for UK provider (default feed is already baked in)
OPEN_XMLTV_UK_URL=

# Add your provider API keys here if needed
# TVMAZE_API_KEY=your_key_here
# BBC_API_KEY=your_key_here
# STREAMTV_API_KEY=your_key_here

# ==================================================
# DEVELOPMENT
# ==================================================

# Show debug information in UI
NEXT_PUBLIC_DEBUG_MODE=false

# Enable framework stats endpoint
NEXT_PUBLIC_ENABLE_STATS=true